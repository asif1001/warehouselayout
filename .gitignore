# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets — never commit these. A Firebase admin key bypasses every Firestore
# rule, so a leaked one hands over every user's data. The web config in
# app/js/firebase-config.js is the opposite: public by design, safe to commit.
*firebase-adminsdk*.json
*adminsdk*.json
serviceAccount*.json
service-account*.json
.firebase/
firebase-debug.log

# Node / web tooling
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build / packaging artifacts
dist/
build/
*.zip
ROADMAP.md

# App runtime — local exports and user data
app/data/*.local.json

# Local launchers
run.bat
